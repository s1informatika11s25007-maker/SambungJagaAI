# ==============================================================================
# SAMBUNGJAGA AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. FRONTEND / VITE ENVIRONMENT VARIABLES (Client Public)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
VITE_APP_ENV=development

# 2. SUPABASE EDGE FUNCTIONS & BACKEND RUNTIME (Server Private)
SUPABASE_PROJECT_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_ACCESS_TOKEN=<your-supabase-access-token>
SUPABASE_DB_PASSWORD=<your-db-password>

# 3. SUPABASE DATABASE CONNECTION POOLER & MIGRATIONS
SUPABASE_DB_POOLER_URL=postgres://postgres.<your-project-ref>:<your-db-password>@<host>:6543/postgres?pgbouncer=true
# DB_SSL_REJECT_UNAUTHORIZED=true # Set to 'false' only for local self-signed testing if necessary

# 4. AI MODEL PROVIDER & INTEGRATIONS (Server Private)
GROQ_API_KEY=<your-groq-api-key>
Groq_Token=<your-groq-api-key>
MODEL_GATEWAY_BASE_URL=https://api.groq.com/openai/v1
GH_TOKEN=<your-github-token>
